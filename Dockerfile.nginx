FROM nginx:alpine

# Drop the default config; the template will render to /etc/nginx/conf.d/ at startup.
RUN rm -f /etc/nginx/conf.d/default.conf

COPY nginx/templates/ /etc/nginx/templates/
COPY viewer/ /usr/share/nginx/html/

# Only substitute these two env vars — leaves nginx's $host, $remote_addr, etc. untouched.
ENV NGINX_ENVSUBST_FILTER="^(MAPS_INTERNAL_API_KEY|TILES_CORS_ORIGIN)$"
