# Required for prod (docker-compose.prod.yml)
# Copy this to `.env` and fill in. Coolify reads these as the Application's environment variables.

# Public hostname Traefik will issue a Let's Encrypt cert for. Must already point at the VPS.
DOMAIN=maps-nginx.saidinusah.com

# Postgres credentials for the spatial DB (`easy_maps`). Use a long random password.
POSTGRES_DB=easy_maps
POSTGRES_USER=easy
POSTGRES_PASSWORD=

# Password for the Redis instance (used for live driver-location geo queries).
REDIS_PASSWORD=

# Internal-only password for the Nominatim Postgres instance.
NOMINATIM_PASSWORD=

# Shared secret the gyeme-api backend sends as `X-Maps-Key` to access /geocode and /routing.
# Generate with: openssl rand -hex 32
MAPS_INTERNAL_API_KEY=

# Comma-separated list of origins allowed to fetch tiles directly from /tiles/*.
# For Expo dev clients, "*" is fine. In prod, lock to your app domains.
TILES_CORS_ORIGIN=*
