{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# All requests proxied to internal nginx, which handles routing,
	# rate limits, CORS, and X-Maps-Key gating.
	reverse_proxy nginx:80 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}
